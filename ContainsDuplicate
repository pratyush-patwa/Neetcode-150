import java.util.Arrays;
import java.util.HashSet;

public class ContainsDuplicate {
    public static void main(String [] args){
        int nums1[] = {1,3,4,5,4,10,8,2};
        int nums2[] = {2,3,4,5,67,11};

        System.out.println(containsDupBF(nums1));
        System.out.println(containsDupBF(nums2));

        System.out.println(containsDupSort(nums1));
        System.out.println(containsDupSort(nums2));

        System.out.println(containsDupOptimal(nums1));
        System.out.println(containsDupOptimal(nums2));
    }

    private static boolean containsDupBF(int [] nums){
        for(int i =0;i<nums.length;i++){
            for(int j =i+1; j<nums.length;j++){
                if(nums[i] == nums[j]){
                    return true;
                }
            }
        }
        return false;
        //TC - O(n * n)
    }

    private static boolean containsDupSort(int [] nums){
        Arrays.sort(nums);
        for(int i =1; i<nums.length; i++){
            if(nums[i] == nums[i-1]){
                return true;
            }
        }
        return false;
        //TC O(n*logn)
    }

    //Optimized Approach
    private static boolean containsDupOptimal(int [] nums){
        HashSet<Integer> set = new HashSet<>();
        for(int n : nums){
            if(!set.contains(n)){
                set.add(n);
            }else{
                return true;
            }
        }
        return false;
        //TC O(n) 
        //SC O(n)
    }


}
