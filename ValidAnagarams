public class ValidAnagrams {
    public static void main(String [] args) {
        String s = "rat";
        String t = "tar";
        System.out.println(checkValidAnagram(s,t));

        String a= "mango";
        String b = "tango";
        System.out.println(checkValidAnagram(a,b));


        String x= "abac";
        String y = "aaac";
        System.out.println(checkValidAnagram(x,y));

        System.out.println(validAnagramsOptimal(s,t));
        System.out.println(validAnagramsOptimal(a,b));
        System.out.println(validAnagramsOptimal(x,y));
    }
    public static boolean checkValidAnagram(String s, String t){
        if(s.length() != t.length())
            return false;
        boolean visited [] = new boolean[s.length()];
        for(int i =0; i<s.length(); i++){
            boolean found =false;
            for(int j =0; j<t.length();j++){
                if(!visited[j] && ( s.charAt(i) == t.charAt(j))){
                    found = true;
                    visited [j] = true;
                    break;
                }
            }
            if(found == false)  {
                return false;
            }
        }
        return true;
        //TC : O(n*n)
    }

    public static boolean validAnagramsOptimal(String s, String t){
        if(s.length() != t.length()){
            return false;
        }
        int [] freqmap = new int[26];
        for(int i=0; i<s.length(); i++){
            freqmap[s.charAt(i)  - 'a'] += 1;
            freqmap[t.charAt(i)  - 'a'] -= 1;
        }

        for(int n: freqmap){
            if(n != 0)
                return false;
        }
        return true;
        //Tc : O(n)
        //Sc : O(1) because array will always be of 26 size
    }
}
